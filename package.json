{
  "name": "cuci2",
  "productName": "CUCI2",
  "version": "1.0.0",
  "description": "Millisecond-precision video cut & merge studio with automatic subtitle sync.",
  "main": "main.js",
  "author": "CUCI2",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "postinstall": "node scripts/fetch-ffmpeg.mjs",
    "fetch:ffmpeg": "node scripts/fetch-ffmpeg.mjs --force",
    "test": "npm run test:locate && npm run test:job && npm run test:nsfw && npm run test:export && npm run test:smoke && npm run test:e2e && npm run test:cancel",
    "test:locate": "node lib/test-locate.js",
    "test:job": "node lib/test-job.js",
    "test:nsfw": "node lib/test-nsfw.js",
    "test:export": "node lib/selftest.js",
    "test:smoke": "electron lib/smoke.js",
    "test:e2e": "electron lib/e2e.js",
    "test:cancel": "electron lib/test-cancel.js",
    "predist": "node scripts/fetch-ffmpeg.mjs --strict",
    "dist": "electron-builder",
    "store:assets": "node scripts/make-store-assets.mjs",
    "store:stage": "node scripts/build-msix.mjs --stage-only",
    "store:package": "node scripts/build-msix.mjs"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.cuci2.app",
    "productName": "CUCI2",
    "files": [
      "main.js",
      "preload.js",
      "panel-preload.js",
      "lib/**/*",
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "vendor/ffmpeg",
        "to": "ffmpeg",
        "filter": [
          "**/*"
        ]
      }
    ],
    "electronLanguages": [
      "en-US"
    ],
    "asarUnpack": [
      "**/node_modules/onnxruntime-node/**"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    }
  },
  "dependencies": {
    "onnxruntime-node": "^1.30.0"
  }
}
