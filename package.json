{
  "name": "cuci",
  "productName": "CUCI - Delete Unnecessary Video Scenes",
  "version": "1.0.3",
  "description": "CUCI — Delete Unnecessary Video Scenes. Millisecond-precision scene deletion, clip merging and automatic subtitle sync.",
  "main": "main.js",
  "author": "SINI Digital Solutions",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "postinstall": "node scripts/fetch-ffmpeg.mjs",
    "fetch:ffmpeg": "node scripts/fetch-ffmpeg.mjs --force",
    "test": "npm run test:locate && npm run test:job && npm run test:nsfw && npm run test:export && npm run test:smoke && npm run test:e2e && npm run test:cancel",
    "test:locate": "node lib/test-locate.js",
    "test:job": "node lib/test-job.js",
    "test:nsfw": "node lib/test-nsfw.js",
    "test:export": "node lib/selftest.js",
    "test:smoke": "electron lib/smoke.js",
    "test:e2e": "electron lib/e2e.js",
    "test:cancel": "electron lib/test-cancel.js",
    "obfuscate": "node scripts/obfuscate.mjs",
    "verify:build": "electron scripts/verify-build.cjs",
    "predist": "node scripts/fetch-ffmpeg.mjs --strict",
    "dist": "node scripts/obfuscate.mjs && node node_modules/electron-builder/cli.js --config.directories.app=.build/app",
    "store:assets": "node scripts/make-store-assets.mjs",
    "store:screenshots": "electron scripts/make-screenshots.cjs",
    "store:stage": "node scripts/obfuscate.mjs && node scripts/build-msix.mjs --stage-only --app-dir .build/app",
    "store:package": "node scripts/obfuscate.mjs && node scripts/build-msix.mjs --app-dir .build/app",
    "store:appx": "node scripts/obfuscate.mjs && node scripts/build-msix.mjs --appx --app-dir .build/app"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^26.15.3",
    "javascript-obfuscator": "^5.9.0"
  },
  "build": {
    "appId": "Slopless.App.CUCI-DeleteUnnecessaryVideoScenes",
    "productName": "CUCI",
    "files": [
      "main.js",
      "preload.js",
      "panel-preload.js",
      "lib/**/*",
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "vendor/ffmpeg",
        "to": "ffmpeg",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "THIRD-PARTY-NOTICES.md",
        "to": "THIRD-PARTY-NOTICES.md"
      },
      {
        "from": "LICENSE",
        "to": "LICENSE.txt"
      }
    ],
    "electronLanguages": [
      "en-US"
    ],
    "asarUnpack": [
      "**/node_modules/onnxruntime-node/**"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    }
  },
  "dependencies": {
    "onnxruntime-node": "^1.30.0"
  }
}
