# dependencies
node_modules/

# build output
dist/
out/

# logs / OS cruft
*.log
.DS_Store
Thumbs.db

# local sample media / scratch folder — never committed (see docs/DEVELOPMENT.md)
Sample/

# vendored ffmpeg binaries + download cache — never committed
# (recreate with: npm run fetch:ffmpeg)
vendor/

# your Partner Center identity for MSIX builds
store/identity.json

# temp / scratch
*.tmp

# obfuscated staging used by build.ps1 (recreated on every build)
.build/

# release hash used by build.ps1 for the automatic version bump
.last-build-hash
