<?xml version="1.0" encoding="utf-8"?>
<!--
  Rendered by scripts/build-msix.mjs — do not edit the copies under dist/.
  {{PLACEHOLDERS}} come from store/identity.json (Partner Center → Product identity).
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <Identity
    Name="{{IDENTITY_NAME}}"
    Publisher="{{PUBLISHER}}"
    Version="{{VERSION}}"
    ProcessorArchitecture="{{ARCH}}" />

  <Properties>
    <DisplayName>{{DISPLAY_NAME}}</DisplayName>
    <PublisherDisplayName>{{PUBLISHER_DISPLAY_NAME}}</PublisherDisplayName>
    <Description>{{DESCRIPTION}}</Description>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.22621.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <!-- EntryPoint=Windows.FullTrustApplication + runFullTrust is required for Electron. -->
    <Application Id="CUCI" Executable="app\CUCI.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="{{DISPLAY_NAME}}"
        Description="{{DESCRIPTION}}"
        BackgroundColor="#0B0D12"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile
          Wide310x150Logo="Assets\Wide310x150Logo.png"
          ShortName="{{SHORT_NAME}}" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" BackgroundColor="#0B0D12" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <!-- Electron needs full trust; the app makes no other capability requests. -->
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
